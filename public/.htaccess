DirectoryIndex home.php index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^data(?:/|$) - [F,L]
RewriteRule ^home/?$ /?view=feed [R=302,L,NE]
RewriteRule ^reels/?$ /?view=reels [R=302,L,NE]
RewriteRule ^map/?$ /?view=map [R=302,L,NE]
RewriteRule ^people/?$ /?view=people [R=302,L,NE]
RewriteRule ^profile/?$ /?view=profile [R=302,L,NE]
RewriteRule ^messages/?$ /?view=messages [R=302,L,NE]
RewriteRule ^notifications/?$ /?view=notifications [R=302,L,NE]
RewriteRule ^games/?$ /?view=games [R=302,L,NE]
RewriteRule ^music/?$ /?view=feed&oyya_page=music [R=302,L,NE]
RewriteRule ^pages/?$ /?view=pages [R=302,L,NE]
RewriteRule ^explore/?$ /?view=explore [R=302,L,NE]
RewriteRule ^saved/?$ /?view=saved [R=302,L,NE]
RewriteRule ^albums/?$ /?view=albums [R=302,L,NE]
RewriteRule ^communities/?$ /?view=communities [R=302,L,NE]
RewriteRule ^events/?$ /?view=events [R=302,L,NE]
RewriteRule ^opportunities/?$ /?view=opportunities [R=302,L,NE]
</IfModule>

<FilesMatch "\.(json|log|sqlite|db)$">
Require all denied
</FilesMatch>

<IfModule mod_php.c>
php_value upload_max_filesize 1024M
php_value post_max_size 1030M
php_value max_execution_time 600
php_value max_input_time 600
</IfModule>
