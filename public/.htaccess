DirectoryIndex home.php index.php index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^data(?:/|$) - [F,L]
RewriteRule ^home/?$ home.php?view=feed [L,QSA]
RewriteRule ^reels/?$ home.php?view=reels [L,QSA]
RewriteRule ^map/?$ home.php?view=map [L,QSA]
RewriteRule ^people/?$ home.php?view=people [L,QSA]
RewriteRule ^profile/?$ home.php?view=profile [L,QSA]
RewriteRule ^messages/?$ home.php?view=messages [L,QSA]
RewriteRule ^notifications/?$ home.php?view=notifications [L,QSA]
RewriteRule ^games/?$ home.php?view=games [L,QSA]
RewriteRule ^music/?$ home.php?view=feed&oyya_page=music [L,QSA]
RewriteRule ^pages/?$ home.php?view=pages [L,QSA]
RewriteRule ^explore/?$ home.php?view=explore [L,QSA]
RewriteRule ^saved/?$ home.php?view=saved [L,QSA]
RewriteRule ^albums/?$ home.php?view=albums [L,QSA]
RewriteRule ^communities/?$ home.php?view=communities [L,QSA]
RewriteRule ^events/?$ home.php?view=events [L,QSA]
RewriteRule ^opportunities/?$ home.php?view=opportunities [L,QSA]
</IfModule>

<FilesMatch "\.(json|log|sqlite|db)$">
Require all denied
</FilesMatch>

<IfModule mod_php.c>
php_value upload_max_filesize 20M
php_value post_max_size 24M
</IfModule>
